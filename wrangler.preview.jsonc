{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "galarza-catalogo-preview",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-21",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "previa.galarzaatelie.com.br", "custom_domain": true }],
  "d1_databases": [
    { "binding": "CATALOG_DB", "database_name": "galarza-catalogo-preview" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/gestao", "/gestao/*", "/api/*"]
  }
}
